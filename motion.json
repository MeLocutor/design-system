    "illustration_reveal_scroll": { "duration": "300-500ms per layer", "stagger": "60-80ms", "easing": "standard", "order": "Structure (Tinta) first → Accent (Brasa) last" },
    "section_reveal_scroll": { "duration": "300ms", "easing": "standard", "transform": "fade + translateY(8px)", "never": ["wipe", "dramatic slide", "zoom"] },
    "page_transition": { "duration": "200ms", "easing": "standard", "type": "Simple fade — no wipe/slide/zoom" }
  },
  "principle": "Motion exists to reveal hierarchy — never to entertain. No auto-loop without user interaction."
